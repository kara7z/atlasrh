<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    logicalFilePath="db/changelog/001-create-hr-tables.xml"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-employees" author="kara">
        <createTable tableName="employees">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_employees"/>
            </column>
            <column name="matricule" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_employees_matricule"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_employees_email"/>
            </column>
            <column name="position" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="hire_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="department_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="manager_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_employees_department"
            baseTableName="employees" baseColumnNames="department_id"
            referencedTableName="departements" referencedColumnNames="id"
            onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint constraintName="fk_employees_manager"
            baseTableName="employees" baseColumnNames="manager_id"
            referencedTableName="employees" referencedColumnNames="id"
            onDelete="RESTRICT" onUpdate="RESTRICT"/>
    </changeSet>
</databaseChangeLog>
